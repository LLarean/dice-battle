  Enemies:
  - Name: "\u041C\u0430\u043B\u044B\u0439 \u0441\u043B\u0430\u0439\u043C"
    Description: "\u0417\u0430\u0431\u0440\u0435\u043B\u0441\u044F \u0432 \u043F\u043E\u0433\u0440\u0435\u0431
      \u0438 \u0441\u044A\u0435\u043B \u0447\u044C\u0451-\u0442\u043E \u0441\u0430\u043F\u043E\u0433\u0438.
      \u041F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437\u043E\u0431\u0438\u0434\u043D\u044B\u0439,
      \u043D\u043E \u0432\u043E\u043D\u044E\u0447\u0435 \u043F\u0440\u0438\u043B\u0438\u043F\u0430\u0435\u0442."
    Portrait: {fileID: -735669648, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 1c958bde6c526ea49acd3d2879fcb488, type: 3}
    MaxHealth: 4
    CurrentHealth: 4
    Damage: 2
    Armor: 0
  - Name: "\u0421\u043B\u0430\u0439\u043C"
    Description: "\u0420\u0430\u0437\u0440\u043E\u0441\u0441\u044F \u043D\u0430 \u043E\u0431\u044A\u0435\u0434\u043A\u0430\u0445
      \u0441 \u043A\u0443\u0445\u043D\u0438 \u0442\u0440\u0430\u043A\u0442\u0438\u0440\u0430.
      \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439, \u043D\u043E \u0437\u0430\u0442\u044F\u043D\u0435\u0442
      \u0432 \u0441\u0435\u0431\u044F \u0437\u0430\u0437\u0435\u0432\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F."
    Portrait: {fileID: 750657890, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 77290d437408bba489950d34739e7714, type: 3}
    MaxHealth: 6
    CurrentHealth: 6
    Damage: 3
    Armor: 0
  - Name: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u043B\u0430\u0439\u043C"
    Description: "\u0421\u043B\u043E\u043F\u0430\u043B \u0441\u043E\u0441\u0435\u0434\u0435\u0439
      \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435 \u0438 \u0440\u0430\u0437\u0434\u0443\u043B\u0441\u044F
      \u0441 \u0431\u043E\u0447\u043A\u0443. \u041C\u0435\u0434\u043B\u0438\u0442\u0435\u043B\u0435\u043D,
      \u043D\u043E \u0434\u0430\u0432\u0438\u0442 \u043C\u0430\u0441\u0441\u043E\u0439."
    Portrait: {fileID: 1682503996, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 38e7f46f0ee18fe409c5180c9acf2716, type: 3}
    MaxHealth: 9
    CurrentHealth: 9
    Damage: 4
    Armor: 0
  - Name: "\u0421\u043A\u0435\u043B\u0435\u0442 \u043B\u0443\u0447\u043D\u0438\u043A"
    Description: "\u0421\u0442\u0440\u0435\u043B\u044F\u043B \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0435
      \u0440\u0430\u0434\u0438 \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F \u2014 \u0441\u0432\u043E\u0435\u0439
      \u043F\u043B\u043E\u0442\u0438 \u0443\u0436\u0435 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
      \u0411\u044C\u0451\u0442 \u0438\u0437\u0434\u0430\u043B\u0438, \u0431\u0440\u043E\u043D\u0438 \u043D\u0435\u0442."
    Portrait: {fileID: -110279060, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: ca95bfa043921c04ebfe8d666590b369, type: 3}
    MaxHealth: 8
    CurrentHealth: 8
    Damage: 4
    Armor: 0
  - Name: "\u0421\u043A\u0435\u043B\u0435\u0442 \u0432\u043E\u0438\u043D"
    Description: "\u041D\u0435 \u043F\u043E\u043C\u043D\u0438\u0442, \u043A\u0435\u043C \u0431\u044B\u043B \u043F\u0440\u0438
      \u0436\u0438\u0437\u043D\u0438, \u0437\u0430\u0442\u043E \u043F\u043E\u043C\u043D\u0438\u0442,
      \u043A\u0430\u043A \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0449\u0438\u0442.
      \u041A\u0440\u0435\u043F\u0447\u0435 \u043B\u0443\u0447\u043D\u0438\u043A\u0430, \u0437\u043B\u0435\u0435 \u0432\u0434\u0432\u043E\u0439\u043D\u0435."
    Portrait: {fileID: -135622888, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 0ab4e8524e6395644a3f5b53339fa1bf, type: 3}
    MaxHealth: 8
    CurrentHealth: 8
    Damage: 4
    Armor: 2
  - Name: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044C"
    Description: "\u0412\u044B\u0440\u0432\u0430\u043B\u0441\u044F \u0438\u0437 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0435\u0433\u043E
      \u0430\u043C\u0443\u043B\u0435\u0442\u0430 \u043C\u0430\u0433\u0430. \u0411\u044C\u0451\u0442
      \u0441\u0442\u0438\u0445\u0438\u0435\u0439 \u043D\u0430\u043E\u0442\u043C\u0430\u0448\u044C,
      \u043D\u043E \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0435\u0447\u0435\u043C."
    Portrait: {fileID: 1616578468, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: d568177668b2b704596764cdf4a5f945, type: 3}
    MaxHealth: 6
    CurrentHealth: 6
    Damage: 5
    Armor: 0
  - Name: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u044C"
    Description: "\u0422\u043E\u0442 \u0436\u0435 \u0430\u043C\u0443\u043B\u0435\u0442, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u0430\u0433 \u0432\u043B\u0438\u043B \u0432 \u043D\u0435\u0433\u043E \u0432\u0441\u044E
      \u043E\u0441\u0442\u0430\u0432\u0448\u0443\u044E\u0441\u044F \u044F\u0440\u043E\u0441\u0442\u044C.
      \u0423\u0440\u043E\u043D \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439, \u0431\u0440\u043E\u043D\u0438 \u2014 \u043D\u043E\u043B\u044C."
    Portrait: {fileID: -89511923, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 7a83ef18b50434549875480c7a2ce916, type: 3}
    MaxHealth: 7
    CurrentHealth: 7
    Damage: 6
    Armor: 0
  - Name: "\u042F\u0449\u0435\u0440"
    Description: "\u0412\u044B\u043B\u0435\u0437 \u0438\u0437 \u0441\u0442\u0430\u0440\u044B\u0445
      \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431 \u0438 \u043E\u0431\u043B\u044E\u0431\u043E\u0432\u0430\u043B
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446. \u0428\u043A\u0443\u0440\u0430 \u043F\u043B\u043E\u0442\u043D\u0430\u044F,
      \u043A\u0443\u0441\u0430\u0435\u0442 \u043D\u0435 \u0441\u043F\u0435\u0448\u0430, \u043D\u043E \u0431\u043E\u043B\u044C\u043D\u043E."
    Portrait: {fileID: 441093746, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: daf1e281e1e6ded4194aaac9d6e64174, type: 3}
    MaxHealth: 10
    CurrentHealth: 10
    Damage: 4
    Armor: 1
  - Name: "\u042F\u0449\u0435\u0440 \u0432\u043E\u0438\u043D"
    Description: "\u0412\u043E\u0436\u0430\u043A \u0441\u0442\u0430\u0438 \u0438\u0437
      \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431, \u043D\u043E\u0441\u0438\u0442 \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u0435
      \u0434\u043E\u0441\u043F\u0435\u0445\u0438 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E
      \u0433\u0435\u0440\u043E\u044F. \u0416\u0438\u0432\u0443\u0447 \u0438 \u0431\u044C\u0451\u0442 \u043A\u0440\u0435\u043F\u043A\u043E."
    Portrait: {fileID: 328333050, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 5a65086367bcdff419cf8c4981e22ed1, type: 3}
    MaxHealth: 11
    CurrentHealth: 11
    Damage: 6
    Armor: 2
  - Name: "\u0414\u0440\u0430\u043A\u043E\u043D"
    Description: "\u0421\u044A\u0435\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F
      \u0438 \u0435\u0433\u043E \u043B\u043E\u0448\u0430\u0434\u044C \u2014 \u0437\u0430\u043E\u0434\u043D\u043E
      \u0438 \u0442\u0440\u0430\u043A\u0442\u0438\u0440, \u0433\u0434\u0435 \u0442\u043E\u0442
      \u0445\u0432\u0430\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0431\u0435\u0434\u043E\u0439. \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435."
    Portrait: {fileID: 86372833, guid: a787ddc3c35124f4980fdbd26ace0ebb, type: 3}
    Background: {fileID: 21300000, guid: 7f5b74ca0989d5b4392d011875961b0f, type: 3}
    MaxHealth: 15
    CurrentHealth: 15
    Damage: 5
    Armor: 3
